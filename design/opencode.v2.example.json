{
  "$schema": "https://opencode.ai/config.json",
  "update": "disable",
  "share": "disabled",
  "model": "corp/corp-evaluator",
  "providers": {
    "corp": {
      "name": "사내 평가 LLM",
      "env": ["CORP_LLM_TOKEN"],
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "{env:CORP_LLM_BASE_URL}"
      },
      "models": {
        "corp-evaluator": {
          "name": "사내 평가 모델 A"
        },
        "corp-evaluator-alt": {
          "name": "사내 평가 모델 B"
        }
      }
    }
  }
}
